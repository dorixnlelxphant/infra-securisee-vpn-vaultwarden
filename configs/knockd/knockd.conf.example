# /etc/knockd.conf  (exemple — séquence à personnaliser)

[options]
    UseSyslog

[openSSH]
    sequence      = PORT1,PORT2,PORT3
    seq_timeout   = 5
    start_command = /sbin/ufw allow from %IP% to any port SSH_PORT
    tcpflags      = syn
    cmd_timeout   = 10
    stop_command  = /sbin/ufw delete allow from %IP% to any port SSH_PORT
